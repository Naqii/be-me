  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "example": "AdminHaqi123"
          }
        },
        "xml": {
          "name": "LoginRequest"
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "member2025"
          },
          "username": {
            "type": "string",
            "example": "member2025"
          },
          "email": {
            "type": "string",
            "example": "member2025@yopmail.com"
          },
          "password": {
            "type": "string",
            "example": "Member2025!"
          },
          "confirmPassword": {
            "type": "string",
            "example": "Member2025!"
          }
        },
        "xml": {
          "name": "RegisterRequest"
        }
      },
      "ActivationRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "abcrandom"
          }
        },
        "xml": {
          "name": "ActivationRequest"
        }
      },
      "RemoveMediaRequest": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": ""
          },
          "resource_type": {
            "type": "string",
            "example": "image/video/raw"
          }
        },
        "xml": {
          "name": "RemoveMediaRequest"
        }
      },
      "CreateImageRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "title images"
          },
          "isShow": {
            "type": "boolean",
            "example": true
          },
          "image": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "example": ""
              },
              "publicId": {
                "type": "string",
                "example": ""
              },
              "resourceType": {
                "type": "string",
                "example": "image"
              }
            }
          }
        },
        "xml": {
          "name": "CreateImageRequest"
        }
      },
      "CreateWorkRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Finall Project Video"
          },
          "thumbnail": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "example": ""
              },
              "publicId": {
                "type": "string",
                "example": ""
              },
              "resourceType": {
                "type": "string",
                "example": "image"
              }
            }
          },
          "content": {
            "type": "string",
            "example": "https://youtu.be/zsXN01GRPGw"
          },
